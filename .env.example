# Site URL used for canonical links, the sitemap, and SEO tags.
PUBLIC_SITE_URL=https://your-domain.example

# --- Keystatic CMS: GitHub storage mode (production editing) ---
# Leave all of these unset for local development: Keystatic falls back to
# writing directly to the filesystem ("local" mode) when they're absent.
# Set them once you've created a Keystatic GitHub App (see README.md).
KEYSTATIC_GITHUB_OWNER=your-github-username-or-org
KEYSTATIC_GITHUB_REPO=your-repo-name
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
