# Site URL used for canonical links, the sitemap, and SEO tags.
# Required for a production build. Do not leave this as example.com.
PUBLIC_SITE_URL=https://gamenews.online

# Google Search Console ownership token (HTML tag method).
# Search Console → Settings → Ownership verification → HTML tag.
# Paste only the content value, not the whole <meta> tag.
# Example: GOOGLE_SITE_VERIFICATION=AbCdEf123exampleToken
# This overrides the CMS field searchConsoleVerification when set.
# Pages are prerendered, so rebuild and redeploy after you add the token.
GOOGLE_SITE_VERIFICATION=

# --- Keystatic CMS: GitHub storage mode (production editing) ---
# Leave all of these unset for local development: Keystatic falls back to
# writing directly to the filesystem ("local" mode) when they're absent.
# Set them once you've created a Keystatic GitHub App (see README.md).
KEYSTATIC_GITHUB_OWNER=your-github-username-or-org
KEYSTATIC_GITHUB_REPO=your-repo-name
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
