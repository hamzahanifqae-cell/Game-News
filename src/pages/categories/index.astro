---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getSiteSettings } from '../../lib/content';

const settings = await getSiteSettings();
const categories = await getCollection('categories');
---

<BaseLayout
  title="Categories"
  description={`Browse content by category on ${settings.siteName}.`}
  canonicalPath="/categories"
>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-sans text-4xl font-bold tracking-tight text-ink sm:text-5xl">Categories</h1>
    <div class="mt-10 grid gap-x-10 sm:grid-cols-2">
      {categories.map((category) => (
        <a
          href={`/categories/${category.id}`}
          class="group border-t border-line py-7 hover:text-brand-700"
        >
          <h2 class="font-serif text-2xl tracking-tight text-ink group-hover:text-brand-700">{category.data.name}</h2>
          {category.data.description && (
            <p class="mt-1 text-sm text-ink-muted">{category.data.description}</p>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
