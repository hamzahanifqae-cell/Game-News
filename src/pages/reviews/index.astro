---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTypeListing from '../../components/ArticleTypeListing.astro';
import { getSiteSettings, hasPublicArticlesOfType } from '../../lib/content';

const settings = await getSiteSettings();
const hasContent = await hasPublicArticlesOfType('review');
---

<BaseLayout
  title="PC Game Reviews & Comparisons"
  description={`Research-based PC game reviews and comparisons from ${settings.siteName}, with official sources and no invented scores.`}
  canonicalPath="/reviews"
  adPageEligible={hasContent}
>
  <ArticleTypeListing
    type="review"
    heading="Reviews"
    intro="In-depth, hands-on reviews of apps worth knowing about."
  />
</BaseLayout>
