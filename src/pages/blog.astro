---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSidebar from '../components/AdSidebar.astro';
import { getPublicCollection, sortByPublishDateDesc } from '../lib/content';
import { formatEditorialDate, pageUrl } from '../lib/seo';
const articles = sortByPublishDateDesc(await getPublicCollection('articles'));
// Each article appears once: upcoming games by release month, then undated ones, then games
// that are out, then guides. A game whose releaseDate has passed moves to "Recently released"
// on the next build (see hasReleased in lib/content.ts).
const news = articles.filter(article => article.data.type === 'news');
const upcoming = news.filter(article => !article.data.released);
const dated = upcoming.filter(article => article.data.releaseDate).sort((a, b) => a.data.releaseDate!.valueOf() - b.data.releaseDate!.valueOf());
const undated = upcoming.filter(article => !article.data.releaseDate);
const released = news.filter(article => article.data.released);
const guides = articles.filter(article => article.data.type !== 'news');
const monthFormat = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const monthMap = new Map<string, { key: string; label: string; entries: typeof dated }>();
for (const article of dated) {
  const date = article.data.releaseDate!;
  const key = `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
  if (!monthMap.has(key)) monthMap.set(key, { key, label: monthFormat.format(date), entries: [] });
  monthMap.get(key)!.entries.push(article);
}
const months = [...monthMap.values()].map(month => [month, month.entries] as const);
const articlePaths = { review: 'reviews', tutorial: 'tutorials', troubleshooting: 'troubleshooting', news: 'news' } as const;
const pageTitle = 'Upcoming PC Games: Release Dates & Watchlist';
const pageHeading = 'Upcoming PC games and release dates.';
const pageDescription = 'Upcoming PC game release dates and watchlists, including Fable, Persona 4 Revival, and Final Fantasy VII Revelation, checked against official listings.';
const site = Astro.site;
const listUrl = pageUrl(site, '/blog');
const jsonLd = site && listUrl ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageHeading,
  description: pageDescription,
  url: listUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.data.title,
      url: new URL(`/${articlePaths[article.data.type]}/${article.id}`, site).toString(),
    })),
  },
} : undefined;
---
<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/blog" jsonLd={jsonLd} adPageEligible={articles.length > 0}>
<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:grid lg:grid-cols-[minmax(0,1fr)_160px] lg:gap-10">
<section class="min-w-0">
<Breadcrumbs items={[{ label: 'Upcoming games' }]} />
<p class="editorial-kicker text-brand-700">The watchlist</p>
<h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{pageHeading}</h1>
<p class="mt-4 max-w-2xl leading-7 text-ink-muted">These upcoming PC game releases are dated editorial snapshots. A confirmed date is a calendar day on the official listing when that article was checked. A tentative entry has no calendar day. A console date is not a PC date. Games you can install now are on <a class="underline text-brand-700" href="/games">popular PC games</a>.</p>
<h2 class="mt-10 text-2xl font-semibold tracking-tight text-ink">Upcoming PC game releases by month</h2>
{months.map(([month, entries]) => (
  <section class="mt-8" aria-labelledby={`month-${month.key}`}>
    <h3 id={`month-${month.key}`} class="text-lg font-semibold text-ink">{month.label}</h3>
    <div class="mt-4 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{entries.map(article => (
      <div><p class="mb-2 text-[13px] leading-5 text-ink-muted"><strong class="text-ink">{formatEditorialDate(article.data.releaseDate!)}</strong>{article.data.releaseDateNote && ` — ${article.data.releaseDateNote}`}</p><ArticleCard article={article} showImage={false} /></div>
    ))}</div>
  </section>
))}
{undated.length > 0 && <section class="mt-10" aria-labelledby="no-date">
  <h3 id="no-date" class="text-lg font-semibold text-ink">No PC calendar date yet</h3>
  <div class="mt-4 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{undated.map(article => (
    <div>{article.data.releaseDateNote && <p class="mb-2 text-[13px] leading-5 text-ink-muted">{article.data.releaseDateNote.charAt(0).toUpperCase() + article.data.releaseDateNote.slice(1)}</p>}<ArticleCard article={article} showImage={false} /></div>
  ))}</div>
</section>}
{released.length > 0 && <section class="mt-14" aria-labelledby="recently-released">
  <h2 id="recently-released" class="text-2xl font-semibold tracking-tight text-ink">Recently released</h2>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-muted">These games have left the watchlist. Each article was updated with the official release details.</p>
  <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{released.map(article => <ArticleCard article={article} showImage={false} />)}</div>
</section>}
{guides.length > 0 && <section class="mt-14" aria-labelledby="guides">
  <h2 id="guides" class="text-2xl font-semibold tracking-tight text-ink">Guides and checklists</h2>
  <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{guides.map(article => <ArticleCard article={article} />)}</div>
</section>}
</section>
<AdSidebar />
</div>
</BaseLayout>
