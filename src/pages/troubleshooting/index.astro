---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTypeListing from '../../components/ArticleTypeListing.astro';
import { getSiteSettings, hasPublicArticlesOfType } from '../../lib/content';

const settings = await getSiteSettings();
const hasContent = await hasPublicArticlesOfType('troubleshooting');
---

<BaseLayout
  title="Game & App Troubleshooting Guides"
  description={`Troubleshooting guides from ${settings.siteName} for common game and app problems, starting with checks that do not change your files.`}
  canonicalPath="/troubleshooting"
  noindex={!hasContent}
  pagefindIndex={hasContent}
  adPageEligible={hasContent}
>
  <ArticleTypeListing
    type="troubleshooting"
    heading="Troubleshooting"
    intro="Checks to try before changing files. These guides do not claim that every case was reproduced on a specific computer."
  />
</BaseLayout>
