---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LiveNews from '../../components/LiveNews.astro';
import { getPublicCollection, sortByPublishDateDesc } from '../../lib/content';

const stories = sortByPublishDateDesc(await getPublicCollection('articles')).filter((article) => article.data.type === 'news');
---
<BaseLayout title="Latest PC Game Updates & Official Announcements" description="Game update news from official Steam announcements, grouped by game with the publisher’s date. A patch version is shown only when the title already includes it." canonicalPath="/updates" adPageEligible={false} pagefindIndex={false}>
<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
<Breadcrumbs items={[{ label: 'Game updates' }]} />
<p class="editorial-kicker text-brand-700">The news desk</p>
<h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Official PC game updates.</h1>
<p class="mt-4 max-w-2xl leading-7 text-ink-muted">This page is game update news from official Steam announcements for Fable, Phantom Blade Zero, The Wolf Among Us 2, Counter-Strike 2, Dota 2, and PUBG. Each line links to the publisher’s post. GameNews does not copy that post. Release-date articles stay on the <a class="underline text-brand-700" href="/blog">upcoming PC games watchlist</a>.</p>
<nav class="mt-8" aria-label="Updates by game">
  <h2 class="text-lg font-semibold text-ink">Scan by game</h2>
  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-brand-700">
    <li><a class="hover:underline" href="#updates-counter-strike-2">Counter-Strike 2</a></li>
    <li><a class="hover:underline" href="#updates-dota-2">Dota 2</a></li>
    <li><a class="hover:underline" href="#updates-pubg-battlegrounds">PUBG</a></li>
    <li><a class="hover:underline" href="#updates-fable">Fable</a></li>
    <li><a class="hover:underline" href="#updates-phantom-blade-zero">Phantom Blade Zero</a></li>
    <li><a class="hover:underline" href="#updates-the-wolf-among-us-2">The Wolf Among Us 2</a></li>
  </ul>
</nav>
<p class="mt-4 max-w-2xl text-sm leading-6 text-ink-muted">Within each game, the date is the publisher’s post date. A patch version appears only when that version is already in the announcement title. The saved headlines include Dota 2’s 7.41f gameplay patch from 15 September 2026. Counter-Strike 2 posts in that list are titled “Counter-Strike 2 Update” and do not name a patch number, so this page links to the official post instead of summarizing one.</p>
{stories.length > 0 && (
  <nav class="mt-8" aria-label="Editorial watchlist">
    <h2 class="text-lg font-semibold text-ink">Release-date articles</h2>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-brand-700">
      {stories.map((article) => (
        <li><a class="hover:underline" href={`/news/${article.id}`}>{article.data.seoTitle || article.data.title}</a></li>
      ))}
    </ul>
  </nav>
)}
<LiveNews limit={18} grouped />
</section>
</BaseLayout>
