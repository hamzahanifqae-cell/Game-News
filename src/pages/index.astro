---
import GtaSpotlight from '../components/GtaSpotlight.astro';
import AppCard from '../components/AppCard.astro';
import LiveNews from '../components/LiveNews.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import AdSlot from '../components/AdSlot.astro';
import { getPublicCollection, sortByPublishDateDesc, getSiteSettings } from '../lib/content';
import { editorialImages } from '../lib/editorial-images';
import { pageUrl } from '../lib/seo';
import gtaArtwork from '../assets/products/gta-vi-banner.jpg';
const settings = await getSiteSettings();
const homepageStories = ['fable-watchlist', 'phantom-blade-zero-watchlist', 'the-wolf-among-us-2-watchlist'];
const articles = sortByPublishDateDesc(await getPublicCollection('articles')).filter(article => homepageStories.includes(article.id)).sort((a,b) => homepageStories.indexOf(a.id) - homepageStories.indexOf(b.id));
const featuredGames = ['gta-v-enhanced', 'cyberpunk-2077', 'red-dead-redemption-2'];
const games = (await getPublicCollection('apps')).filter(app => featuredGames.includes(app.id)).sort((a, b) => featuredGames.indexOf(a.id) - featuredGames.indexOf(b.id));
const lead = articles[0];
const rest = articles.filter(a => a.id !== lead?.id);
const secondary = rest[0];
const third = rest.find(a => a.id !== secondary?.id && a.data.category === 'games') || rest.find(a => a.id !== secondary?.id);
const appStory = rest.find(a => a.id !== secondary?.id && a.id !== third?.id);
const paths = { review: 'reviews', tutorial: 'tutorials', troubleshooting: 'troubleshooting', news: 'news' } as const;
const href = (article: (typeof articles)[number]) => `/${paths[article.data.type]}/${article.id}`;
// Only the first occurrence of a source image is illustrated on this page.
const seen = new Set<string>();
function claimImage(article: (typeof articles)[number] | undefined) {
  if (!article?.data.coverImage || seen.has(article.data.coverImage.src)) return false;
  seen.add(article.data.coverImage.src); return true;
}
const leadImage = claimImage(lead), secondaryImage = claimImage(secondary), thirdImage = claimImage(third), appImage = claimImage(appStory);
const homeTitle = 'GTA VI News, Upcoming Games & PC Updates';
const homeDescription = 'Grand Theft Auto VI news from official Rockstar sources, plus upcoming PC games, publisher updates, and popular games with official Steam downloads.';
const site = Astro.site;
const homeUrl = pageUrl(site, '/');
const organizationId = site ? new URL('/#organization', site).toString() : undefined;
const websiteId = site ? new URL('/#website', site).toString() : undefined;
const homeJsonLd = site && homeUrl && organizationId && websiteId ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeUrl,
      name: settings.siteName,
      description: homeDescription,
      inLanguage: 'en',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: settings.siteName,
      url: homeUrl,
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', site).toString() },
    },
    {
      '@type': 'WebPage',
      '@id': new URL('/#webpage', site).toString(),
      url: homeUrl,
      name: `${homeTitle} | ${settings.siteName}`,
      description: homeDescription,
      isPartOf: { '@id': websiteId },
      about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI' },
      inLanguage: 'en',
    },
  ],
} : undefined;
const topics = [
  {href:'/games', title:'Find your next game', copy:'Explore the shortlist. Check the details. Pick your next adventure.', icon:'game', tone:'violet'},
  {href:'/blog', title:'See what’s coming', copy:'Upcoming games, official reveals, and the questions worth asking.', icon:'guide', tone:'orange'},
  {href:'/updates', title:'Catch the latest', copy:'Fresh publisher announcements, with dates and original sources.', icon:'fix', tone:'teal'},
];
---
<BaseLayout title={homeTitle} description={homeDescription} canonicalPath="/" ogImage={gtaArtwork.src.includes('@fs') ? undefined : gtaArtwork.src} jsonLd={homeJsonLd} adPageEligible={articles.length > 0}>
<div class="magazine mx-auto max-w-6xl px-4 sm:px-6">
  <nav class="topic-strip" aria-label="Explore topics"><span class="explore-label">EXPLORE</span><a href="/games">PC gaming</a><a href="/apps">Useful apps</a><a href="/blog">Upcoming games</a><a href="/updates">Game updates</a><a href="/blog" class="all-topics">All stories <span aria-hidden="true">↗</span></a></nav>
  <GtaSpotlight />
  <section class="popular-downloads" aria-label="Popular games"><div class="section-top"><div><p class="section-eyebrow">READY TO PLAY</p><h2>Popular games. Official downloads.</h2></div><a href="/games" class="text-link">All popular games ↗</a></div><div class="grid gap-5 md:grid-cols-3">{games.map(game => <AppCard app={game} />)}</div></section>
  <div class="section-top mt-12"><div><p class="section-eyebrow">ON THE HORIZON</p><h2>Upcoming games worth watching.</h2></div><a href="/blog" class="text-link">All upcoming blogs ↗</a></div>
  <section class="feature-grid" aria-label="Featured stories">
    {lead ? <article class="feature-lead">
      {leadImage && <Image src={lead.data.coverImage!} alt={lead.data.coverImageAlt} width={1100} height={760} widths={[480,768,1100]} sizes="(min-width: 900px) 700px, 100vw" format="webp" quality={85} loading="lazy" class="feature-background" />}
      <div class="lead-content"><span class="feature-label lime">ON THE WATCHLIST</span><p class="feature-category">UPCOMING / EDITORIAL</p><h2><a href={href(lead)}>{lead.data.title}</a></h2><p class="lead-description">{lead.data.description}</p><div class="feature-bottom"><span>Editorial feature · {lead.data.publishDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span><a href={href(lead)} class="round-link" aria-label={`Read ${lead.data.title}`}>↗</a></div></div>
      {lead.data.coverImageSource && <a href={lead.data.coverImageSource} target="_blank" rel="noopener noreferrer" class="feature-credit">Publisher image · source ↗</a>}
    </article> : <article class="feature-lead"><Image src={editorialImages.review.src} alt={editorialImages.review.alt} width={1100} height={760} class="feature-background" /><div class="lead-content"><span class="feature-label lime">COMING SOON</span><h2>Something good is taking shape.</h2><p>Our first original guides are on their way.</p><a href="/about" class="magazine-button">Meet GameNews ↗</a></div></article>}
    <div class="feature-side">
      {secondary && <article class="side-feature">{secondaryImage && <Image src={secondary.data.coverImage!} alt={secondary.data.coverImageAlt} width={700} height={430} format="webp" class="feature-background" />}<div class="side-content"><span class="feature-label">NEXT ON THE RADAR</span><h2><a href={href(secondary)}>{secondary.data.title}</a></h2><a class="text-link" href={href(secondary)}>Read the feature <span aria-hidden="true">↗</span></a></div></article>}
      {third && <article class="side-comparison">{thirdImage && <Image src={third.data.coverImage!} alt={third.data.coverImageAlt} width={400} height={400} format="webp" class="comparison-image" />}<div><span class="section-eyebrow">COMING INTO FOCUS</span><h2><a href={href(third)}>{third.data.title}</a></h2><a href={href(third)} class="text-link">Explore the story ↗</a></div></article>}
    </div>
  </section>
  <div class="reading-note"><span class="reading-note-icon" aria-hidden="true">✦</span><strong>A little context goes a long way.</strong><p>Original features. Official announcements. Clearly dated sources.</p><a href="/about">How we write ↗</a></div>
  <LiveNews limit={6} />
  <section class="discovery-section"><div class="section-top"><div><p class="section-eyebrow">PICK A DIRECTION</p><h2>What brings you here?</h2></div><span class="section-aside">A good place to start.</span></div><div class="discovery-grid">{topics.map((topic, index) => <a href={topic.href} class={`discovery-card ${topic.tone}`}><span class="discovery-icon" aria-hidden="true">{topic.icon === 'game' ? <svg viewBox="0 0 32 32" fill="none"><path d="M10 11h12c5 0 7 13 3 14-2 1-4-3-5-3h-8c-1 0-3 4-5 3-4-1-2-14 3-14Z" stroke="currentColor" stroke-width="1.8"/><path d="M9 16h6m-3-3v6m9-4h.1m3 3h.1" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg> : topic.icon === 'guide' ? <svg viewBox="0 0 32 32" fill="none"><path d="M7 5h18v23H7zM12 11h8m-8 5h8m-8 5h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg> : <svg viewBox="0 0 32 32" fill="none"><path d="m19 4-10 14h7l-2 10 10-15h-7l2-9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>}</span><span class="discovery-number">0{index+1}</span><h3>{topic.title}</h3><p>{topic.copy}</p><span class="discovery-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <AdSlot placement="homeMid" format="banner" pageEligible={articles.length > 0} />
  {appStory && <section class="app-spotlight"><div class="app-visual">{appImage && <Image src={appStory.data.coverImage!} alt={appStory.data.coverImageAlt} width={800} height={600} format="webp" loading="lazy" class="spotlight-image" />}<span class="image-caption">{appStory.data.coverImageCredit}</span></div><div class="app-copy"><span class="feature-label soft">A LITTLE LESS FRUSTRATION</span><h2>{appStory.data.title}</h2><p>{appStory.data.description}</p><a href={href(appStory)} class="magazine-button">Get the practical steps <span aria-hidden="true">↗</span></a><span class="research-note">Research-based guidance. No invented test results.</span></div></section>}

  <section class="journal-invitation"><div><p class="section-eyebrow">THERE’S MORE TO EXPLORE</p><h2>Follow your curiosity.</h2><p>Explore upcoming games and follow the latest publisher announcements.</p></div><a href="/blog" class="magazine-button">Explore the watchlist ↗</a></section>
</div>
</BaseLayout>
<style>
.magazine { padding-bottom: 12px; }
.topic-strip { display:flex; align-items:center; gap:24px; padding:18px 0; border-bottom:1px solid var(--color-line); font-size:16px; font-weight:500; color:var(--color-ink-muted); flex-wrap:wrap; line-height:1.6; }
.explore-label { color:var(--color-brand-600); font-size:13px; font-weight:700; letter-spacing:.15em; }
.topic-strip a:hover { color:var(--color-brand-600); }.all-topics { margin-left:auto; color:var(--color-ink); }
.magazine-intro { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; padding:38px 0 28px; }
.section-eyebrow { font-size:13px; letter-spacing:.13em; font-weight:700; color:var(--color-brand-600); }
h1 { font-size:clamp(2.4rem,4.7vw,3.8rem); line-height:1.06; letter-spacing:-.04em; font-weight:700; margin:10px 0 12px; }h1 span { color:var(--color-brand-600); }
.magazine-intro p:last-child { color:var(--color-ink-muted); font-size:13px; line-height:1.7; }
.magazine-button { display:inline-flex; align-items:center; justify-content:center; gap:20px; padding:14px 20px; border-radius:10px; background:var(--color-brand-600); color:white; font-size:13px; line-height:1.4; font-weight:600; white-space:nowrap; transition:background .18s; }.magazine-button:hover{background:var(--color-brand-700);}
.feature-grid { display:grid; grid-template-columns:1.55fr 1fr; gap:18px; }.feature-lead { position:relative; min-height:510px; overflow:hidden; border-radius:20px; background:#132039; color:white; }.feature-background { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.feature-lead::after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,#11172a00 5%,#10162955 30%,#101629eb 80%); pointer-events:none; }.lead-content { position:relative; z-index:1; padding:32px; padding-top:160px; }.feature-label { display:inline-block; font-size:13px; font-weight:700; letter-spacing:.11em; border-radius:5px; background:#ffffff22; color:white; padding:7px 10px; }.lime { background:#cdf77c; color:#26351b; }.feature-category { margin-top:22px; font-size:13px; letter-spacing:.12em; color:#d1d9e7; }.lead-content h2 { font-size:clamp(1.8rem,3vw,2.6rem); line-height:1.12; letter-spacing:-.035em; font-weight:700; max-width:530px; margin-top:12px; }.lead-content h2 a:hover { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; }.lead-description { max-width:460px; margin-top:16px; font-size:15px; line-height:1.7; color:#d4dbe7; }.feature-bottom { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:22px; font-size:13px; color:#b9c5d8; }.round-link { display:grid; place-items:center; width:36px; height:36px; border:1px solid #ffffff55; border-radius:50%; font-size:20px; color:white; }.feature-credit { position:absolute; z-index:2; right:20px; top:18px; color:white; font-size:13px; padding:5px 8px; border-radius:4px; background:#11172a90; }
.feature-side { display:grid; grid-template-rows:1.1fr 1fr; gap:18px; }.side-feature { position:relative; overflow:hidden; border-radius:18px; background:#162039; color:white; }.side-feature::after {content:'';position:absolute;inset:0;background:linear-gradient(0deg,#11172af0,#11172a05);}.side-content {position:relative;z-index:1;padding:24px;padding-top:48px;}.side-content h2 {font-size:22px;font-weight:700;line-height:1.22;letter-spacing:-.025em;margin:16px 0;}.text-link {font-size:15px;font-weight:600;display:inline-flex;gap:18px;}.side-comparison {display:grid;grid-template-columns:.8fr 1fr;gap:18px;align-items:center;padding:20px;border-radius:18px;background:#fff;border:1px solid var(--color-line);}.comparison-image {width:100%;aspect-ratio:1;object-fit:contain;border-radius:10px;background:#f1f3fa;}.side-comparison h2 {font-size:18px;line-height:1.3;font-weight:700;letter-spacing:-.025em;margin:10px 0 16px;}.side-comparison .text-link {color:var(--color-brand-600);}
.reading-note {display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin:20px 0 44px;padding:16px 20px;border:1px solid var(--color-line);border-radius:12px;background:white;font-size:13px;}.reading-note-icon{font-size:21px;color:var(--color-brand-600);}.reading-note p{color:var(--color-ink-muted);}.reading-note a{margin-left:auto;font-weight:600;white-space:nowrap;color:var(--color-brand-600);}
.section-top {display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px;}.section-top h2,.journal-invitation h2 {font-size:clamp(1.7rem,3vw,2.25rem);font-weight:700;letter-spacing:-.04em;line-height:1.15;margin-top:8px;}.section-aside {font-size:13px;color:var(--color-ink-muted);}.discovery-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}.discovery-card {position:relative;display:block;padding:24px 24px 54px;border-radius:16px;transition:transform .2s;}.discovery-card:hover {transform:translateY(-3px);}.violet{background:#e9eaff;color:#3737a2;}.orange{background:#fff0e6;color:#9c4825;}.teal{background:#e0f3ef;color:#17665b;}.discovery-icon{display:grid;place-items:center;width:43px;height:43px;background:#ffffff88;border:1px solid #ffffffbb;border-radius:12px;}.discovery-icon svg{width:28px;height:28px;}.discovery-number{position:absolute;top:28px;right:24px;font-size:13px;opacity:.6;font-weight:600;}.discovery-card h3{margin-top:22px;font-size:20px;line-height:1.2;letter-spacing:-.025em;font-weight:700;}.discovery-card p{font-size:13px;line-height:1.8;margin-top:10px;opacity:.85;}.discovery-arrow{position:absolute;right:24px;bottom:22px;font-size:21px;}
.app-spotlight {display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center;margin:48px 0;background:white;border:1px solid var(--color-line);border-radius:20px;padding:28px;}.app-visual{background:#edf0f8;border-radius:14px;padding:24px 20px 14px;}.spotlight-image{width:100%;height:245px;object-fit:contain;}.image-caption{display:block;font-size:13px;color:var(--color-ink-muted);line-height:1.5;margin-top:12px;}.soft{background:#e9f2ff;color:#355da5;}.app-copy h2{font-size:clamp(1.6rem,2.7vw,2rem);font-weight:700;line-height:1.18;letter-spacing:-.035em;margin:18px 0 14px;}.app-copy p{font-size:13px;line-height:1.8;color:var(--color-ink-muted);}.app-copy .magazine-button{margin-top:22px;}.research-note{display:block;font-size:13px;color:var(--color-ink-muted);margin-top:14px;}
.game-lounge{border-radius:22px;background:#14213b;color:white;padding:36px;position:relative;overflow:hidden;}.game-lounge .section-eyebrow{color:#c9f477;}.lounge-intro{font-size:13px;color:#b2bfd5;margin-top:12px;}.lounge-link{font-size:13px;font-weight:600;color:#c9f477;white-space:nowrap;}.lounge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}.lounge-card{padding:22px;border-radius:14px;background:#ffffff09;border:1px solid #ffffff19;transition:background .2s;}.lounge-card:hover{background:#ffffff13;}.lounge-card-top{display:flex;justify-content:space-between;color:#a8b7d1;font-size:13px;}.lounge-card-top span:last-child{color:#c9f477;font-size:18px;}.lounge-card h3{font-size:21px;letter-spacing:-.03em;font-weight:600;margin-top:24px;}.lounge-card p{font-size:13px;line-height:1.8;color:#b4c1d8;margin-top:12px;}.game-developer{display:block;margin-top:20px;padding-top:15px;border-top:1px solid #ffffff17;font-size:13px;color:#b4c1d8;line-height:1.8;}.journal-invitation{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:48px 0;}.journal-invitation p:last-child{font-size:13px;color:var(--color-ink-muted);margin-top:12px;}
@media(max-width:1000px){.feature-grid{grid-template-columns:1.25fr 1fr;}.side-comparison{grid-template-columns:1fr;padding:18px;gap:12px;}.comparison-image{display:none;}.side-content{padding:20px;}.side-content h2{font-size:20px;}.lead-content{padding:26px;padding-top:160px;}.reading-note p{display:none;}.app-spotlight{gap:26px;}.lounge-card{padding:18px;}}
@media(max-width:700px){.topic-strip{gap:18px;padding:14px 0;}.all-topics{display:none;}.magazine-intro{padding:28px 0 24px;align-items:flex-start;}.magazine-intro>.magazine-button{display:none;}h1{font-size:2.75rem;}.feature-grid{grid-template-columns:1fr;}.feature-lead{min-height:440px;}.lead-content{padding:24px;padding-top:150px;}.lead-content h2{font-size:1.9rem;}.feature-side{grid-template-columns:1fr;grid-template-rows:auto;gap:12px;}.side-content{padding:18px;}.side-content h2{font-size:17px;}.feature-label{font-size:13px;padding:6px 8px;}.side-comparison{padding:18px;}.side-comparison h2{font-size:17px;}.feature-credit{font-size:13px;}.reading-note{padding:14px;gap:10px;font-size:13px;}.reading-note a{font-size:13px;}.section-aside{display:none;}.discovery-grid{grid-template-columns:1fr;gap:12px;}.discovery-card{padding:20px 70px 20px 82px;min-height:130px;}.discovery-icon{position:absolute;left:20px;top:24px;}.discovery-card h3{margin-top:0;font-size:19px;}.discovery-number{display:none;}.discovery-arrow{bottom:24px;}.app-spotlight{grid-template-columns:1fr;padding:20px;gap:24px;margin:32px 0;}.app-visual{padding:18px;}.spotlight-image{height:220px;}.game-lounge{padding:24px;}.lounge-grid{grid-template-columns:1fr;}.lounge-card h3{margin-top:12px;}.section-top{align-items:flex-start;}.lounge-link{font-size:13px;}.journal-invitation{align-items:flex-start;flex-direction:column;padding:34px 0;}}
@media(max-width:380px){h1{font-size:2.4rem;}.feature-side{grid-template-columns:1fr;}.feature-lead{min-height:430px;}.reading-note strong{font-size:13px;}.reading-note a{display:none;}.lead-content h2{font-size:1.7rem;}.lead-description{font-size:13px;}}
@media(prefers-reduced-motion:reduce){.discovery-card:hover{transform:none;}}
</style>
