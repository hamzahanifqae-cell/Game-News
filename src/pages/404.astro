---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
---

<BaseLayout
  title="Page not found"
  description="The page you're looking for doesn't exist."
  noindex
  pagefindIndex={false}
  adPageEligible={false}
>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">404</p>
    <h1 class="mt-2 font-sans text-3xl font-bold tracking-tight text-ink">We couldn't find that page</h1>
    <p class="mt-3 text-ink-muted">
      It may have been moved, renamed, or never existed. Try searching, or head back to the homepage.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="btn-primary">Go to homepage</a>
      <a href="/search" class="btn-secondary">Search {settings.siteName}</a>
    </div>
  </section>
</BaseLayout>
