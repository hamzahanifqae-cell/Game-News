---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
const email = settings.contactEmail.trim();
const hasEmail = email.includes('@');
---
<BaseLayout
  title="Contact GameNews"
  description={hasEmail ? `Contact ${settings.businessLegalName || settings.siteName}, the publisher of GameNews.` : `Contact page for GameNews. A public email address has not been published yet.`}
  canonicalPath="/contact"
  noindex={!hasEmail}
  pagefindIndex={hasEmail}
  adPageEligible={false}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">Contact</h1>
    <div class="prose-article mt-6">
      <p>
        {settings.businessLegalName
          ? `${settings.businessLegalName} publishes ${settings.siteName}.`
          : `${settings.siteName} has not published the publisher’s name yet.`}
        {' '}Editorial articles stay bylined {settings.siteName}.
      </p>
      {hasEmail ? (
        <p>Email <a href={`mailto:${email}`}>{email}</a>.</p>
      ) : (
        <p>A public contact email has not been published yet. This page does not offer a form, and it will not show a success message for a message the site cannot deliver.</p>
      )}
      {hasEmail && (
        <>
          <h2>What to write about</h2>
          <ul>
            <li><strong>Corrections.</strong> A release date, platform, edition, or store link that no longer matches the official source. Include the page URL and, if you can, the official page that shows the current information.</li>
            <li><strong>Broken or wrong links.</strong> An official Steam, Rockstar, or publisher link on a {settings.siteName} page that goes to the wrong place or no longer loads.</li>
            <li><strong>Images and rights.</strong> A rights holder asking about a cover image or other artwork shown on the site.</li>
            <li><strong>Privacy.</strong> Questions about the cookies, consent message, or analytics described in the <a href="/privacy">privacy policy</a>.</li>
          </ul>
          <h2>What this address cannot help with</h2>
          <p>
            {settings.siteName} is not the developer, publisher, or store for any game it covers. It cannot help with purchases, refunds, accounts, installs, or game support. Contact the store or publisher for those. Each profile and article links to the official source.
          </p>
        </>
      )}
      <p>Read <a href="/about">how GameNews is written</a>, the <a href="/terms">terms of use</a>, or the <a href="/privacy">privacy policy</a>.</p>
    </div>
  </article>
</BaseLayout>
