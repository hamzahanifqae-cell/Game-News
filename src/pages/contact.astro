---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();
const email = settings.contactEmail.trim();
const hasEmail = email.includes('@');
---
<BaseLayout
  title="Contact GameNews"
  description={hasEmail ? `Contact ${settings.businessLegalName || settings.siteName}, the publisher of GameNews.` : `Contact page for GameNews. A public email address has not been published yet.`}
  canonicalPath="/contact"
  noindex={!hasEmail}
  pagefindIndex={hasEmail}
  adPageEligible={false}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">Contact</h1>
    <div class="prose-article mt-6">
      <p>
        {settings.businessLegalName
          ? `${settings.businessLegalName} publishes ${settings.siteName}.`
          : `${settings.siteName} has not published the publisher’s name yet.`}
        {' '}Editorial articles stay bylined {settings.siteName}.
      </p>
      {hasEmail ? (
        <p>Email <a href={`mailto:${email}`}>{email}</a>.</p>
      ) : (
        <p>A public contact email has not been published yet. This page does not offer a form, and it will not show a success message for a message the site cannot deliver.</p>
      )}
      <p>Read <a href="/about">how GameNews is written</a> or the <a href="/privacy">privacy policy</a>.</p>
    </div>
  </article>
</BaseLayout>
