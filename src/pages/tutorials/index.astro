---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleTypeListing from '../../components/ArticleTypeListing.astro';
import { getSiteSettings, hasPublicArticlesOfType } from '../../lib/content';

const settings = await getSiteSettings();
const hasContent = await hasPublicArticlesOfType('tutorial');
---

<BaseLayout
  title="PC Game Guides & Buying Checklists"
  description={`Practical PC game guides from ${settings.siteName}: what to check before you install or buy, with official store links.`}
  canonicalPath="/tutorials"
  adPageEligible={hasContent}
>
  <ArticleTypeListing
    type="tutorial"
    heading="Tutorials"
    intro="Step-by-step guides to help you get more out of the apps you use."
  />
</BaseLayout>
