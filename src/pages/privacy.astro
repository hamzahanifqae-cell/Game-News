---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getLegalPage, getSiteSettings } from '../lib/content';
import { adsMasterEnabled, googleConsentMessageSrc } from '../lib/ads';

const page = await getLegalPage('legalPrivacy');
const { Content: AdditionalNotes } = await render(page);
const hasAdditionalNotes = Boolean(page.body?.trim());
const settings = await getSiteSettings();
const adsActive = adsMasterEnabled(settings);
const messageOnSite = Boolean(googleConsentMessageSrc(settings.adsensePublisherId, '/', settings.cmpProvider));

const reviewDate = page.data.policyReviewDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// Treated as a draft until a human has set an explicit review date — kept
// out of the sitemap and out of on-site search while in that state (see
// astro.config.mjs for the matching sitemap exclusion). Whether the business
// details below are filled in is a separate, launch-readiness-script
// concern (`npm run launch-check`) — it is not shown to readers here.
const isDraft = !page.data.policyReviewDate;
---

<BaseLayout
  title={page.data.seoTitle || 'Privacy Policy'}
  description={page.data.seoDescription || `Privacy policy for ${settings.siteName}.`}
  canonicalPath="/privacy"
  noindex={isDraft}
  pagefindIndex={!isDraft}
  adPageEligible={!isDraft}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">Privacy Policy</h1>
    <p class="mt-2 text-sm text-ink-muted">
      {reviewDate ? `Last reviewed ${reviewDate}.` : 'This policy has not yet been reviewed — treat it as a draft.'}
    </p>

    <div class="prose-article mt-6">
      <h2>Who we are</h2>
      <p>
        {settings.businessLegalName
          ? <>{settings.siteName} is published by {settings.businessLegalName}. The site name and editorial byline remain {settings.siteName}.</>
          : 'The publisher of this site has not been named yet.'}
        {' '}
        {settings.contactEmail
          ? <>You can reach the publisher at <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>.</>
          : <>A public contact email has not been published yet. See the <a href="/contact">contact page</a>.</>}
      </p>

      <h2>Information we collect</h2>
      {settings.analyticsProvider === 'none' && (
        <p>We do not currently run any analytics service on this site.</p>
      )}
      {settings.analyticsProvider === 'plausible' && (
        <p>
          We use <a href="https://plausible.io/data-policy" target="_blank" rel="noopener noreferrer">Plausible Analytics</a>,
          a privacy-friendly analytics service that does not use cookies and does not collect or store any personal
          data about individual visitors.
        </p>
      )}
      {settings.analyticsProvider === 'ga4' && settings.cmpProvider === 'none' && (
        <p>
          We use Google Analytics 4 to understand how visitors use this site. The analytics script is not added on
          these pages, so no analytics request is sent. Learn more about{' '}
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">
            how Google uses information from sites that use its services
          </a>.
        </p>
      )}
      {settings.analyticsProvider === 'ga4' && settings.cmpProvider !== 'none' && (
        <p>
          We use Google Analytics 4 to understand how visitors use this site. This site uses Google's{' '}
          <a href="https://support.google.com/analytics/answer/9976101" target="_blank" rel="noopener noreferrer">
            Basic Consent Mode
          </a>: the Google Analytics code is not loaded in your browser, and no request to Google is made, until you
          grant analytics consent through the consent banner described below. If you don't consent, no Google
          Analytics request happens at all. Learn more about{' '}
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">
            how Google uses information from sites that use its services
          </a>.
        </p>
      )}

      <h2>Fonts</h2>
      <p>
        This site's fonts are hosted on our own server, not fetched from Google Fonts or any other third party —
        loading a page here doesn't send your IP address to a font provider.
      </p>

      <h2>Advertising</h2>
      <p>
        Third-party vendors, including Google, use cookies to serve ads based on a user’s prior visits to this site or other sites.
        Google’s advertising cookies allow Google and its partners to use those visits to select ads.
        You can control ad personalization in{' '}
        <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">Google My Ad Center</a>.
        This disclosure follows{' '}
        <a href="https://support.google.com/adsense/answer/1348695" target="_blank" rel="noopener noreferrer">Google’s guidance for sites that use AdSense</a>.
      </p>
      <p>
        Google AdSense is the only advertising service configured for {settings.siteName}. No other ad network serves ads here, so there is no separate opt-out for another network.
        The authorized seller is listed in <a href="/ads.txt">ads.txt</a>.
        {adsActive
          ? ' The AdSense library is not loaded until you grant advertising consent. After that, Google may use advertising cookies as described above.'
          : messageOnSite
            ? ' Ad placement is currently off, so this site does not place an ad unit. The AdSense script loads on pages other than this privacy policy so Google can show its published European regulations message to visitors in the EEA, the UK, and Switzerland. An ad is not placed until advertising is turned on and you grant advertising consent.'
            : ' Ad serving is currently off. The AdSense library is not loaded, and this site does not set Google advertising cookies, until advertising is turned on and you grant advertising consent.'}
      </p>

      <h2>Cookie and advertising consent</h2>
      {settings.cmpProvider === 'none' && messageOnSite && (
        <p>
          Google’s European regulations message, published in AdSense for this site, is the consent message for
          visitors in the EEA, the UK, and Switzerland. The AdSense script loads so Google can show that message.
          This site does not serve personalized ads while ad placement is off.
        </p>
      )}
      {settings.cmpProvider === 'none' && !messageOnSite && (
        <p>
          No consent management platform is currently configured. In line with Google's requirements, this site
          will not serve personalized ads to visitors in the European Economic Area, the UK, or Switzerland until a
          Google-certified, IAB TCF-integrated consent management platform is configured and verified.
        </p>
      )}
      {settings.cmpProvider !== 'none' && !settings.cmpConfiguredAndVerified && (
        <p>
          A consent management platform is configured but has not yet been verified as correctly integrated with
          Google Consent Mode. Until that verification is complete, this site does not serve personalized ads to
          visitors in the European Economic Area, the UK, or Switzerland.
        </p>
      )}
      {settings.cmpProvider !== 'none' && settings.cmpConfiguredAndVerified && (
        <p>
          We use a consent management platform integrated with the IAB Transparency &amp; Consent Framework (TCF)
          to collect and manage cookie, analytics, and advertising consent choices. You can change your choices at
          any time, including withdrawing consent you previously gave, using the consent preferences control that
          platform provides.
        </p>
      )}

      <h2>Contact and messages</h2>
      <p>
        This site has no account registration and no contact form. It does not store a message submitted on the site, and it does not show a success message for a message it did not send.
        {settings.contactEmail
          ? <> Questions can be sent to <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>.</>
          : ' A public contact email has not been published yet, so the site cannot receive email through these pages.'}
      </p>

      <h2>Links and publisher feeds</h2>
      <p>
        A link to Steam, Rockstar, or another official site leaves {settings.siteName}. That site receives the request from your browser only after you follow the link.
        Our server reads Steam’s public announcement feed to show a title, a date, and the official URL. It does not copy the announcement onto a {settings.siteName} page, and that server request is not tied to a visitor account.
      </p>

      <h2>Your choices</h2>
      <p>
        You can control cookies through your browser settings and, where a consent banner is shown, through the choices offered there.
        Ad personalization is managed in{' '}
        <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer">Google My Ad Center</a>.
        {settings.contactEmail ? (
          <> Questions about data we may hold can be sent to <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>.</>
        ) : (
          <> A public contact email has not been published yet.</>
        )}
      </p>

      <h2>Children's privacy</h2>
      <p>This site is not directed at children and we do not knowingly collect personal data from children.</p>

      <h2>Changes to this policy</h2>
      <p>We may update this policy as the services we use change. The review date above reflects the most recent human review.</p>

      {hasAdditionalNotes && <AdditionalNotes />}
    </div>
  </article>
</BaseLayout>
