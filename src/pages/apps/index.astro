---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCard from '../../components/AppCard.astro';
import { getPublicCollection, getSiteSettings } from '../../lib/content';

const settings = await getSiteSettings();
const apps = (await getPublicCollection('apps')).filter(app => app.data.category !== 'games');
---

<BaseLayout
  title="Apps"
  description={`App information pages from ${settings.siteName}: specifications and official links.`}
  canonicalPath="/apps"
  adPageEligible={apps.length > 0}
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">Apps</h1>
    <p class="mt-2 max-w-2xl text-ink-muted">
      Specifications and official links for the apps we cover — no files hosted here.
    </p>

    {apps.length > 0 ? (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    ) : (
      <div class="mt-10 rounded-xl border border-line bg-white p-8 text-center">
        <p class="text-ink-muted">Nothing here yet — check back soon.</p>
      </div>
    )}
  </section>
</BaseLayout>
