---
import { editorialImages } from '../../lib/editorial-images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { getCategory, getPublicCollection } from '../../lib/content';
import { pageUrl } from '../../lib/seo';
import { shareImage } from '../../lib/share-image';

export async function getStaticPaths() {
  const apps = await getPublicCollection('apps');
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { data } = app;
const { Content } = await render(app);
const category = await getCategory(data.category);

const relatedArticles = (await getPublicCollection('articles')).filter(
  (article) => article.data.relatedApp === app.id
);
const isGame = data.category === 'games';
const seoTitle = data.seoTitle || (isGame ? `${data.name} PC: Official Steam Download` : `${data.name}: Official Download & App Info`);
const seoDescription = data.seoDescription || `${data.description} Official store link only. GameNews does not host the download.`;
const appPageUrl = pageUrl(Astro.site, `/apps/${app.id}`);
const ownedPreview = editorialImages.review;
const image = await shareImage(data.coverImage ?? ownedPreview.src);
const imageUrl = data.coverImage && image ? pageUrl(Astro.site, image.src) : undefined;
const categoryHref = data.category === 'games' ? '/games' : '/apps';
const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': isGame ? 'VideoGame' : 'SoftwareApplication',
  name: data.name,
  description: data.description,
  ...(data.developer ? { author: { '@type': 'Organization', name: data.developer } } : {}),
  ...(isGame
    ? { gamePlatform: 'PC', applicationCategory: 'Game' }
    : { applicationCategory: 'Utilities', operatingSystem: data.platforms.join(', ') }),
  ...(appPageUrl ? { url: appPageUrl } : {}),
  ...(imageUrl ? { image: imageUrl } : {}),
  sameAs: data.officialLink,
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalPath={`/apps/${app.id}`}
  ogImage={image?.src}
  ogImageAlt={data.coverImage ? data.coverImageAlt : ownedPreview.alt}
  ogImageWidth={image?.width}
  ogImageHeight={image?.height}
  jsonLd={appJsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs items={[{ label: data.category === 'games' ? 'Popular Games' : 'Apps', href: data.category === 'games' ? '/games' : '/apps' }, { label: data.name }]} />

    {category && (
      <a href={categoryHref} class="text-xs font-medium text-ink-muted hover:text-brand-700">
        {category.data.name}
      </a>
    )}

    <h1 class="mt-2 font-sans text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      {data.name}
    </h1>
    <p class="mt-3 text-ink-muted">{data.description}</p>

    {data.category === 'games' && <div class="mt-6"><a href={data.officialLink} target="_blank" rel="noopener noreferrer" class="btn-primary">Open the official Steam page for {data.name} <span aria-hidden="true">↗</span><span class="sr-only"> (opens the official store in a new tab)</span></a><p class="mt-2 text-xs text-ink-muted">Opens the official Steam page. Installation is handled by Steam; GameNews does not host game files. The cover is the publisher’s promotional artwork.</p></div>}
    <figure class="mt-7">
      <Image src={data.coverImage || editorialImages.review.src} alt={data.coverImage ? data.coverImageAlt : editorialImages.review.alt} width={1100} height={680} format="webp" class="aspect-[16/10] w-full rounded-sm bg-surface object-contain" />
      {data.coverImageCredit && <figcaption class="mt-2 text-xs leading-5 text-ink-muted">{data.coverImageCredit}{data.coverImageSource && <> · <a href={data.coverImageSource} target="_blank" rel="noopener noreferrer" class="underline">Image source</a></>}</figcaption>}
      {!data.coverImage && <figcaption class="mt-2 text-xs text-ink-muted">Illustrative editorial artwork · not an app screenshot</figcaption>}
    </figure>

    {isGame && (
      <div class="prose-article mt-8">
        <h2>Platforms and editions</h2>
        <p>Steam’s app details, checked 8 November 2026, list these PC platforms for {data.name}: {data.platforms.map((platform) => ({ android: 'Android', ios: 'iOS', windows: 'Windows', macos: 'macOS', linux: 'Linux', web: 'Web' })[platform] ?? platform).join(', ') || 'see the Steam page'}.</p>
        <p>Editions, bundles, and add-ons are purchase options on that Steam page. Compare the exact product title before you pay. This profile does not quote a price, and a console edition is not the same as this PC listing.</p>
        <h2>How to check system requirements</h2>
        <ol>
          <li>Open the official Steam page linked above.</li>
          <li>Find the system requirements for the edition you intend to install.</li>
          <li>Compare your operating system, processor, memory, graphics, and free storage with the minimum and recommended columns.</li>
          <li>Treat a minimum listing as the publisher’s floor, not a promise of a particular frame rate.</li>
        </ol>
      </div>
    )}

    <div class="mt-8">
      <SpecTable app={app} />
    </div>

    <div class="prose-article mt-8">
      <Content />
    </div>

    <AdSlot placement="appBottom" format="in-article" />

    {relatedArticles.length > 0 && (
      <div class="mt-12 border-t border-line pt-10">
        <h2 class="mb-5 text-xl font-semibold text-ink">Related articles</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {relatedArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
