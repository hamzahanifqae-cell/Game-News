---
import type { CollectionEntry } from 'astro:content';
import ArticleDetail from '../components/ArticleDetail.astro';
import { editorialImages } from '../lib/editorial-images';
import { shareImage } from '../lib/share-image';
import BaseLayout from './BaseLayout.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const typeToPath = {
  review: 'reviews',
  tutorial: 'tutorials',
  troubleshooting: 'troubleshooting',
  news: 'news',
} as const;
const ownedPreview = editorialImages[article.data.type];
const image = await shareImage(article.data.coverImage ?? ownedPreview.src);
---

<BaseLayout
  title={article.data.seoTitle || article.data.title}
  description={article.data.seoDescription || article.data.description}
  canonicalPath={`/${typeToPath[article.data.type]}/${article.id}`}
  ogType="article"
  ogImage={image?.src}
  ogImageAlt={article.data.coverImage ? article.data.coverImageAlt : ownedPreview.alt}
  ogImageWidth={image?.width}
  ogImageHeight={image?.height}
  publishedTime={article.data.publishDate.toISOString()}
  modifiedTime={article.data.updatedDate?.toISOString()}
>
  <ArticleDetail article={article} shareImage={article.data.coverImage ? image?.src : undefined} />
</BaseLayout>
