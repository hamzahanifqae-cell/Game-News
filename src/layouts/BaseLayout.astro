---
import '../styles/global.css';
import manrope800 from '../assets/fonts/manrope-latin-800-normal.woff2';
import sourceSans400 from '../assets/fonts/source-sans-3-latin-400-normal.woff2';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentScripts from '../components/ConsentScripts.astro';
import AdBanner from '../components/AdBanner.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { adsterraBanners, AD_MEDIA, ADSTERRA_SOCIAL_BAR_SRC, ADSTERRA_POPUNDER_SRC, adsterraWriteScript } from '../lib/adsterra';
import { getSiteSettings } from '../lib/content';
import { searchConsoleVerification } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** Schema.org graph for this page. Rendered once in the document head. */
  jsonLd?: unknown;
  /** Set false for error/utility pages (404, search) that shouldn't appear in on-site search results. */
  pagefindIndex?: boolean;
  /**
   * Page-level ad-eligibility flag. It was used by Google AdSense, which has
   * been removed from this site. It is kept so existing pages keep compiling;
   * the Adsterra units are placed directly in the layout and components.
   */
  adPageEligible?: boolean;
}

const {
  title,
  description,
  noindex = false,
  canonicalPath,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  pagefindIndex = true,
  adPageEligible = true,
} = Astro.props;
const settings = await getSiteSettings();
const searchConsoleToken = searchConsoleVerification(settings.searchConsoleVerification);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={sourceSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope800} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={description}
      siteName={settings.siteName}
      noindex={noindex}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      jsonLd={jsonLd}
    />

    {/* Search Console ownership verification. */}
    {searchConsoleToken && (
      <meta name="google-site-verification" content={searchConsoleToken} />
    )}

    {/* Must come before any ad tag: reads the visitor's saved cookie choice. */}
    <ConsentBanner part="head" />
    <ConsentScripts settings={settings} adsPageEligible={adPageEligible} pathname={Astro.url.pathname} />

    {settings.analyticsProvider === 'plausible' && settings.analyticsId && (
      <script is:inline defer data-domain={settings.analyticsId} src="https://plausible.io/js/script.js" />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    {/* Adsterra header banners: below the sticky header, never inside the navigation. */}
    <div class="header-ad mx-auto w-full max-w-6xl px-4 pt-4 sm:px-6" data-pagefind-ignore>
      <AdBanner {...adsterraBanners.leaderboard728x90} media={AD_MEDIA.desktop} class="hidden md:block" />
      <AdBanner {...adsterraBanners.mobile320x50} media={AD_MEDIA.mobile} class="block md:hidden" />
    </div>
    <main id="main-content" class="flex-1" data-pagefind-body={pagefindIndex ? true : undefined}>
      <slot />
    </main>
    <Footer />
    <!-- Adsterra Social Bar (not loaded if the visitor rejected advertising cookies) -->
    <script is:inline set:html={adsterraWriteScript(`<script data-cfasync="false" src="${ADSTERRA_SOCIAL_BAR_SRC}"></script>`)}></script>
    <!-- Adsterra Popunder (not loaded if the visitor rejected advertising cookies) -->
    <script is:inline set:html={adsterraWriteScript(`<script data-cfasync="false" src="${ADSTERRA_POPUNDER_SRC}"></script>`)}></script>
    <ConsentBanner part="body" ga4MeasurementId={settings.analyticsProvider === 'ga4' ? settings.analyticsId : null} />
  </body>
</html>
