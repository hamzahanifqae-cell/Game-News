---
import { Image } from 'astro:assets';
import artwork from '../assets/products/gta-vi-banner.jpg';
const updates = [
  { date: '2026-10-15', label: 'October 15, 2026', type: 'Trailer', title: 'The launch trailer is here.', description: 'Rockstar has featured the GTA VI launch trailer on its official site. Watch the original video for the latest look at the game.', source: 'https://www.rockstargames.com/newswire/article/517572321a549a', action: 'Watch at Rockstar' },
  { date: '2026-10-08', label: 'October 8, 2026', type: 'Music', title: 'Tune in to the sound of Leonida.', description: 'Rockstar’s radio-station announcement offers a closer look at GTA VI’s in-game music. Explore the publisher’s post for the lineup and details.', source: 'https://www.rockstargames.com/newswire/article/o3982oa93a23k4/the-music-of-grand-theft-auto-vi-in-game-radio-stations', action: 'Explore the announcement' },
  { date: '2026-10-16', label: 'Checked October 16, 2026', type: 'Release watch', title: 'November 19 is the current target.', description: 'The official site lists November 19, 2026 for PlayStation 5 and Xbox Series X|S. Check Rockstar for any subsequent changes to availability.', source: 'https://www.rockstargames.com/VI', action: 'Check official release details' },
];
---
<section class="gta-spotlight" aria-labelledby="gta-title">
  <div class="gta-banner">
    <Image src={artwork} alt="Official Grand Theft Auto VI artwork featuring Jason, Lucia, and scenes from Leonida." width={1920} height={1080} widths={[480,768,1120,1600,1920]} sizes="(min-width: 1200px) 1104px, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" class="gta-artwork" />
    <div class="gta-topline"><span class="gta-badge"><span aria-hidden="true">✦</span> THE BIG SPOTLIGHT</span><span class="gta-publisher">ROCKSTAR GAMES</span></div>
    <div class="gta-banner-content"><div><p class="gta-eyebrow">VICE CITY. A NEW CHAPTER.</p><h1 id="gta-title">Grand Theft Auto <span>VI.</span></h1><p class="gta-subtitle">The trailers. The world. The road to release.</p></div><div class="gta-actions"><a class="gta-primary" href="#gta-updates">Explore GTA VI updates <span aria-hidden="true">↓</span></a><a class="gta-secondary" href="https://www.rockstargames.com/VI/launch-trailer" target="_blank" rel="noopener noreferrer">Watch official trailer <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div>
    <a href="https://www.rockstargames.com/VI" target="_blank" rel="noopener noreferrer" class="gta-credit">Official artwork © Rockstar Games · source ↗</a>
  </div>
  <div class="gta-updates" id="gta-updates">
    <div class="gta-updates-heading"><div><p class="gta-eyebrow">THE LATEST FROM LEONIDA</p><h2>GTA VI, in focus.</h2></div><p>Official sources.<br />Checked October 16, 2026.</p></div>
    <div class="gta-update-grid">{updates.map((update,index) => <article class="gta-update"><div class="gta-update-meta"><span>{update.type}</span><span class="gta-number" aria-hidden="true">0{index+1}</span></div><h3>{update.title}</h3><p>{update.description}</p><time datetime={update.date}>{update.label}</time><a href={update.source} target="_blank" rel="noopener noreferrer">{update.action}<span aria-hidden="true">↗</span><span class="sr-only"> (opens Rockstar in a new tab)</span></a></article>)}</div>
    <p class="gta-source-note">Dated coverage of Rockstar’s official announcements. New developments may follow; use the source links for the publisher’s current information.</p>
  </div>
</section>
<style>
.gta-spotlight{margin:26px 0 48px;border-radius:24px;overflow:hidden;background:#160d28;border:1px solid #3a254b;box-shadow:0 18px 50px #25113416;color:#fff;}
.gta-banner{position:relative;isolation:isolate;min-height:610px;display:flex;flex-direction:column;justify-content:space-between;background:#271039;}
.gta-artwork{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 36%;z-index:-2;}
.gta-banner::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,#170b2666 0%,#170b2600 22%,#170b2600 45%,#170b26c9 76%,#170b26 100%);}
.gta-topline{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;padding:28px 32px;}
.gta-badge{display:inline-flex;align-items:center;gap:9px;padding:9px 12px;background:#fff0e4;color:#57264d;border-radius:6px;font-size:13px;font-weight:700;letter-spacing:.08em;}.gta-badge span{color:#c14883;}.gta-publisher{font-size:13px;font-weight:600;letter-spacing:.08em;text-shadow:0 2px 8px #000;}
.gta-banner-content{padding:280px 34px 56px;display:flex;align-items:flex-end;justify-content:space-between;gap:22px;}.gta-eyebrow{font-size:13px;font-weight:700;letter-spacing:.1em;color:#f6b7cd;}.gta-banner h1{font-size:clamp(2rem,4.3vw,3.65rem);font-weight:800;line-height:1.08;letter-spacing:-.045em;margin:12px 0;max-width:650px;}.gta-banner h1 span{color:#ffb7ce;}.gta-subtitle{font-size:15px;color:#ece0f1;line-height:1.6;}.gta-actions{display:flex;flex-direction:column;align-items:stretch;gap:12px;flex-shrink:0;padding-bottom:3px;}.gta-primary,.gta-secondary{display:flex;align-items:center;justify-content:space-between;gap:22px;font-size:13px;font-weight:600;padding:14px 18px;border-radius:8px;}.gta-primary{background:#fbc3d2;color:#351b39;}.gta-primary:hover{background:#ffe2eb;}.gta-secondary{background:#ffffff0d;border:1px solid #ffffff45;color:#fff;}.gta-secondary:hover{background:#ffffff20;}.gta-credit{max-width:calc(100% - 40px);line-height:1.5;position:absolute;right:16px;bottom:10px;color:#d8c8df;font-size:12px;}.gta-credit:hover{text-decoration:underline;}
.gta-updates{padding:30px 32px 22px;scroll-margin-top:100px;background:linear-gradient(130deg,#21122f,#130d23);border-top:1px solid #ffffff17;}.gta-updates-heading{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:24px;}.gta-updates-heading h2{font-size:clamp(1.65rem,3vw,2.2rem);line-height:1.2;letter-spacing:-.035em;font-weight:700;margin-top:9px;}.gta-updates-heading>p{color:#bcaec8;font-size:13px;line-height:1.7;text-align:right;}.gta-update-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;}.gta-update{padding:20px;border-radius:12px;background:#ffffff05;border:1px solid #ffffff1c;display:flex;flex-direction:column;}.gta-update-meta{display:flex;justify-content:space-between;align-items:center;font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:#f6b7cd;}.gta-number{color:#91809f;}.gta-update h3{font-size:19px;font-weight:700;line-height:1.35;letter-spacing:-.02em;margin:17px 0 12px;}.gta-update>p{font-size:15px;color:#c7bcd1;line-height:1.7;flex:1;}.gta-update time{font-size:13px;color:#ae9dbc;display:block;margin:20px 0 15px;}.gta-update>a{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid #ffffff1a;padding-top:14px;font-size:13px;font-weight:600;color:#ffd4df;}.gta-update>a:hover{color:#fff;text-decoration:underline;}.gta-source-note{font-size:13px;color:#a99ab6;line-height:1.7;margin-top:20px;}
@media(max-width:900px){.gta-banner-content{flex-direction:column;align-items:flex-start;padding-top:310px;}.gta-actions{flex-direction:row;flex-wrap:wrap;}.gta-banner h1{font-size:2.8rem;}.gta-update-grid{gap:12px;}.gta-update{padding:16px;}.gta-update h3{font-size:17px;}}
@media(max-width:600px){.gta-spotlight{margin-top:18px;border-radius:17px;}.gta-banner{min-height:570px;}.gta-topline{padding:18px;}.gta-publisher{font-size:13px;}.gta-badge{font-size:13px;padding:8px;}.gta-artwork{object-position:50% 15%;}.gta-banner-content{padding:290px 20px 62px;gap:20px;}.gta-banner h1{font-size:2.35rem;}.gta-subtitle{font-size:15px;}.gta-actions{width:100%;flex-direction:column;gap:9px;}.gta-primary,.gta-secondary{font-size:13px;padding:12px 14px;}.gta-credit{font-size:12px;left:20px;right:auto;}.gta-updates{padding:24px 20px 20px;}.gta-updates-heading{align-items:flex-start;}.gta-updates-heading>p{font-size:13px;}.gta-update-grid{grid-template-columns:1fr;}.gta-update{padding:20px;}.gta-update h3{font-size:20px;}.gta-eyebrow{font-size:13px;}.gta-source-note{font-size:13px;}}
</style>
