---
/**
 * One Adsterra banner, using Adsterra's own tag exactly as the dashboard gives it: an inline
 * `atOptions` script followed by the invoke script, placed in the HTML where the ad should show.
 *
 * Adsterra's publisher terms (clause 4.7) do not allow wrapping the tag in an iframe or altering
 * it. Because the browser runs the two scripts in page order as it reads the HTML, each banner's
 * invoke script reads its own atOptions before the next banner sets a new one.
 *
 * For a banner limited to some screen sizes (`media`), a one-line check writes the same tag only
 * when the size matches, so a banner that would be hidden is never loaded (the terms also forbid
 * making an ad invisible).
 */
import { ADSTERRA_BANNER_SRC } from '../lib/adsterra';

interface Props {
  adKey: string;
  width: number;
  height: number;
  /** Media query the banner is shown for. Pair it with matching CSS classes on `class`. */
  media?: string;
  class?: string;
}

const { adKey, width, height, media = 'all', class: className = '' } = Astro.props;

const optionsScript = `
  atOptions = {
    'key' : '${adKey}',
    'format' : 'iframe',
    'height' : ${height},
    'width' : ${width},
    'params' : {}
  };
`;
const invokeSrc = `${ADSTERRA_BANNER_SRC}${adKey}`;
const tagHtml = `<script>${optionsScript}</script><script data-cfasync="false" src="${invokeSrc}"></script>`;
// Written from inside a <script>, so "</" must not appear literally.
const gatedWrite = `if (window.matchMedia(${JSON.stringify(media)}).matches) { document.write(${JSON.stringify(tagHtml).replace(/<\//g, '<\\/')}); }`;
---

<div class:list={['ad-banner', className]} data-pagefind-ignore>
  <div class="ad-banner-inner">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" style={`width:${width}px;min-height:${height}px`}>
      {media === 'all' ? (
        <>
          <script is:inline set:html={optionsScript}></script>
          <script is:inline data-cfasync="false" src={invokeSrc}></script>
        </>
      ) : (
        <script is:inline set:html={gatedWrite}></script>
      )}
    </div>
  </div>
</div>

<style>
  /* No display rule on .ad-banner itself, so placement classes such as "hidden md:block" decide
     whether the slot is visible. */
  .ad-banner { max-width: 100%; }
  .ad-banner-inner { display: flex; flex-direction: column; align-items: center; max-width: 100%; }
  .ad-label { margin: 0 0 4px; font-size: 11px; line-height: 1; letter-spacing: .06em; text-transform: uppercase; color: #8a8f98; }
  /* Never wider than the screen: on very narrow phones a 300px unit is clipped, not overflowing. */
  .ad-slot { max-width: 100%; overflow: hidden; }
</style>
