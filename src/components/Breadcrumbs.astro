---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 text-sm text-ink-muted" data-pagefind-ignore>
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {item.href ? (
          <a href={item.href} class="hover:text-brand-700">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-ink">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-line">/</span>}
      </li>
    ))}
  </ol>
</nav>
