---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { editorialImages } from '../lib/editorial-images';
import Breadcrumbs from './Breadcrumbs.astro';
import TypeBadge from './TypeBadge.astro';
import TableOfContents from './TableOfContents.astro';
import TrailerEmbed from './TrailerEmbed.astro';
import SteamWatch from './SteamWatch.astro';
import SteamWidget from './SteamWidget.astro';
import ArticleCard from './ArticleCard.astro';
import ArticleSidebar from './ArticleSidebar.astro';
import { ADSTERRA_NATIVE_KEY, ADSTERRA_NATIVE_SRC, adsterraWriteScript } from '../lib/adsterra';
import { getCategory, getPublicEntry, getPublicCollection, sortByPublishDateDesc, getSiteSettings } from '../lib/content';
import { formatEditorialDate, jsonLd as serializeJsonLd, pageUrl } from '../lib/seo';

interface Props {
  article: CollectionEntry<'articles'>;
  shareImage?: string;
}

const { article, shareImage } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);

const category = await getCategory(data.category);
const author = await getPublicEntry('authors', data.author);
const relatedApp = await getPublicEntry('apps', data.relatedApp);

const typeToPath = { review: 'reviews', tutorial: 'tutorials', troubleshooting: 'troubleshooting', news: 'news' } as const;
const typeToLabel = { review: 'Reviews', tutorial: 'Tutorials', troubleshooting: 'Troubleshooting', news: 'News' } as const;

const formattedPublish = formatEditorialDate(data.publishDate);
const formattedUpdated = data.updatedDate ? formatEditorialDate(data.updatedDate) : undefined;

const related = sortByPublishDateDesc(
  (await getPublicCollection('articles')).filter(
    (a) => a.id !== article.id && a.data.category === data.category
  )
).slice(0, 3);

const settings = await getSiteSettings();
const canonicalPath = `/${typeToPath[data.type]}/${article.id}`;
const siteUrl = pageUrl(Astro.site, canonicalPath);
const publisherUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const authorUrl = author?.data.kind === 'Organization' ? pageUrl(Astro.site, '/about') : undefined;
const imageUrl = shareImage ? pageUrl(Astro.site, shareImage) : undefined;
const section = data.type === 'news'
  ? { label: data.released ? 'Game news' : 'Upcoming games', href: '/blog' }
  : { label: typeToLabel[data.type], href: `/${typeToPath[data.type]}` };
const categoryHref = category?.id === 'games' ? '/blog' : category ? `/categories/${category.id}` : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': data.type === 'news' ? 'NewsArticle' : 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
  ...(imageUrl ? { image: [imageUrl] } : {}),
  ...(author
    ? {
        author: {
          '@type': author.data.kind,
          name: author.data.name,
          ...(authorUrl ? { url: authorUrl } : {}),
        },
      }
    : {}),
  ...(siteUrl ? { mainEntityOfPage: siteUrl } : {}),
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: settings.siteName,
    ...(publisherUrl ? { url: publisherUrl } : {}),
  },
};
---

{/* Phones and tablets: one column. From 1024px: article + right sidebar. From 1280px: a sticky
    contents column on the left as well (the inline contents box above the article is then hidden). */}
<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 xl:max-w-[80rem] xl:grid-cols-[190px_minmax(0,1fr)_280px]">
<div class="hidden xl:block">
  <TableOfContents headings={headings} variant="rail" />
</div>
<div class="min-w-0">
  <Breadcrumbs items={[section, { label: data.title }]} />

  <article>
    <div class="flex items-center gap-2">
      <TypeBadge type={data.type} released={data.released} />
      {category && categoryHref && (
        <a href={categoryHref} class="text-xs font-medium text-ink-muted hover:text-brand-700">
          {category.data.name}
        </a>
      )}
    </div>

    <h1 class="mt-3 font-sans text-3xl font-bold leading-[1.12] tracking-tight text-ink sm:text-5xl">
      {data.title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
      {author && (
        <span>
          By{' '}
          {author.data.kind === 'Organization' ? (
            <a href="/about" class="font-medium text-ink hover:text-brand-700">{author.data.name}</a>
          ) : (
            <span class="font-medium text-ink">{author.data.name}</span>
          )}
        </span>
      )}
      <time datetime={data.publishDate.toISOString()}>{formattedPublish}</time>
      {formattedUpdated && <span>· Updated {formattedUpdated}</span>}
    </div>

    {data.trailer && <TrailerEmbed {...data.trailer} />}

    {(data.coverImage || data.type === 'tutorial' || data.type === 'troubleshooting') && (
    <figure class="mt-7">
      <Image src={data.coverImage || editorialImages[data.type].src} alt={data.coverImage ? data.coverImageAlt : editorialImages[data.type].alt} width={1100} height={680} widths={[480, 768, 1100]} sizes="(min-width: 768px) 720px, 100vw" format="webp" class="aspect-[16/10] w-full rounded-sm bg-surface object-contain" />
      {data.coverImageCredit && <figcaption class="mt-2 text-xs leading-5 text-ink-muted">{data.coverImageCredit}{data.coverImageSource && <> · <a href={data.coverImageSource} target="_blank" rel="noopener noreferrer" class="underline">Image source</a></>}</figcaption>}
      {!data.coverImage && <figcaption class="mt-2 text-xs text-ink-muted">Illustrative editorial artwork · not an app screenshot</figcaption>}
    </figure>
    )}

    {relatedApp && (
      <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-y border-line py-5">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">App info</p>
          <p class="font-semibold text-ink">{relatedApp.data.name}</p>
        </div>
        <a href={`/apps/${relatedApp.id}`} class="btn-secondary shrink-0">View app info</a>
      </div>
    )}

    <div class="mt-8">
      <TableOfContents headings={headings} />

      <div class="prose-article" id="article-body">
        {/* inArticleAd: markdoc.config.mjs places the Adsterra 300x250 after the 2nd paragraph. */}
        <Content inArticleAd={true} />
      </div>
    </div>

    {data.steamAppIds && data.steamAppIds.length > 0 && <SteamWidget appIds={data.steamAppIds} />}

    {article.id === 'phantom-blade-zero-watchlist' && <SteamWatch />}

    {/* Adsterra Native Banner: end of the article, before the author box and related reading. */}
    <div class="native-ad mt-10" data-pagefind-ignore>
      <p class="mb-1 text-center text-[11px] uppercase tracking-[.06em] text-[#8a8f98]">Advertisement</p>
      <script is:inline set:html={adsterraWriteScript(`<script async fetchpriority="high" data-cfasync="false" src="${ADSTERRA_NATIVE_SRC}"></script>`)}></script>
      <div id={`container-${ADSTERRA_NATIVE_KEY}`}></div>
    </div>

    {author && (
      <div class="mt-10 flex items-center gap-3 border-t border-line pt-6">
        {author.data.avatar && (
          <Image src={author.data.avatar} alt="" width={48} height={48} class="h-12 w-12 rounded-full object-cover" />
        )}
        <div>
          <p class="font-semibold text-ink">{author.data.name}</p>
          {author.data.bio && <p class="text-sm text-ink-muted">{author.data.bio}</p>}
        </div>
      </div>
    )}
  </article>

  {related.length > 0 && (
    <div class="mt-14 border-t border-line pt-10">
      <h2 class="mb-5 section-heading text-ink">Related reading</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((a) => <ArticleCard article={a} />)}
      </div>
    </div>
  )}
</div>
<ArticleSidebar currentId={article.id} />
</div>

<script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
