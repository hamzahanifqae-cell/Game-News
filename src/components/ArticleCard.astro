---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { editorialImages } from '../lib/editorial-images';
import TypeBadge from './TypeBadge.astro';
import { getCategory } from '../lib/content';
import { formatEditorialDate } from '../lib/seo';

interface Props {
  showImage?: boolean;
  article: CollectionEntry<'articles'>;
}

const { article, showImage = true } = Astro.props;
const { data } = article;
const category = await getCategory(data.category);
// A post that was revised after publication shows its update date, so an October publish date
// never sits next to November news without context. The original date stays in the title attribute.
const shownDate = data.updatedDate ?? data.publishDate;
const formattedDate = data.updatedDate ? `Updated ${formatEditorialDate(data.updatedDate)}` : formatEditorialDate(data.publishDate);
const dateTitle = data.updatedDate ? `First published ${formatEditorialDate(data.publishDate)}` : undefined;

const typeToPath = { review: 'reviews', tutorial: 'tutorials', troubleshooting: 'troubleshooting', news: 'news' } as const;
const href = `/${typeToPath[data.type]}/${article.id}`;
// Only tutorial and troubleshooting have a topic illustration. News and review cards about
// specific games are text-first unless the article has its own approved cover image.
const fallbackArt = data.type === 'tutorial' || data.type === 'troubleshooting' ? editorialImages[data.type] : undefined;
const hasArt = showImage && Boolean(data.coverImage || fallbackArt);
---

<article class="story-card group flex flex-col">
  {hasArt && (
  <a href={href} class="mb-5 block aspect-[16/10] overflow-hidden rounded-sm bg-slate-100" tabindex="-1" aria-hidden="true" data-type={data.type}>
    {data.coverImage ? (
      <Image src={data.coverImage} alt={data.coverImageAlt} width={640} height={400} format="webp" loading="lazy" class="h-full w-full object-contain bg-surface" />
    ) : (
      <Image src={fallbackArt!.src} alt={fallbackArt!.alt} width={640} height={400} format="webp" loading="lazy" class="h-full w-full object-contain bg-surface" />
    )}
  </a>
  )}
  <div class="flex flex-1 flex-col">
    <div class="mb-3 flex flex-wrap items-center gap-3"><TypeBadge type={data.type} released={data.released} />{category && <span class="text-[13px] text-ink-muted">{category.data.name}</span>}</div>
    <h3 class="font-serif text-2xl font-medium leading-[1.2] tracking-tight text-ink"><a href={href} class="hover:text-brand-700">{data.title}</a></h3>
    <p class="mt-3 line-clamp-3 flex-1 text-[15px] leading-relaxed text-ink-muted">{data.description}</p>
    <div class="mt-5 flex items-center justify-between"><time datetime={shownDate.toISOString()} title={dateTitle} class="text-[13px] text-ink-muted">{formattedDate}</time><span aria-hidden="true" class="text-brand-600">↗</span></div>
  </div>
</article>
