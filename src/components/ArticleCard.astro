---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { editorialImages } from '../lib/editorial-images';
import TypeBadge from './TypeBadge.astro';
import { getCategory } from '../lib/content';

interface Props {
  showImage?: boolean;
  article: CollectionEntry<'articles'>;
}

const { article, showImage = true } = Astro.props;
const { data } = article;
const category = await getCategory(data.category);
const formattedDate = data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const typeToPath = { review: 'reviews', tutorial: 'tutorials', troubleshooting: 'troubleshooting', news: 'news' } as const;
const href = `/${typeToPath[data.type]}/${article.id}`;
---

<article class="story-card group flex flex-col">
  {showImage && (
  <a href={href} class="mb-5 block aspect-[16/10] overflow-hidden rounded-sm bg-slate-100" tabindex="-1" aria-hidden="true" data-type={data.type}>
    {data.coverImage ? (
      <Image src={data.coverImage} alt={data.coverImageAlt} width={640} height={400} format="webp" loading="lazy" class="h-full w-full object-contain bg-surface" />
    ) : (
      <Image src={editorialImages[data.type].src} alt="" width={640} height={400} format="webp" loading="lazy" class="h-full w-full object-contain bg-surface" />
    )}
  </a>
  )}
  <div class="flex flex-1 flex-col">
    <div class="mb-3 flex flex-wrap items-center gap-3"><TypeBadge type={data.type} />{category && <span class="text-[13px] text-ink-muted">{category.data.name}</span>}</div>
    <h3 class="font-serif text-2xl font-medium leading-[1.2] tracking-tight text-ink"><a href={href} class="hover:text-brand-700">{data.title}</a></h3>
    <p class="mt-3 line-clamp-3 flex-1 text-[15px] leading-relaxed text-ink-muted">{data.description}</p>
    <div class="mt-5 flex items-center justify-between"><time datetime={data.publishDate.toISOString()} class="text-[13px] text-ink-muted">{formattedDate}</time><span aria-hidden="true" class="text-brand-600">↗</span></div>
  </div>
</article>
